# ---------------------------------------------------------------------------
# Single source of truth for both the PostgreSQL container (docker compose,
# which auto-loads this file) and the API server (server/app/config.py).
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=stockboard
POSTGRES_PASSWORD=stockboard
POSTGRES_DB=stockboard
POSTGRES_HOST=localhost
# Host-side port. 5433 avoids clashing with a PostgreSQL already on 5432.
POSTGRES_PORT=5433
TZ=Asia/Taipei

# Optional: set this to override the connection string built from the values
# above -- e.g. to point the server at a managed database instead.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Host-side ports published by docker compose for the two app containers.
SERVER_PORT=8000
FRONTEND_PORT=8100

# --- Database backups ---
# The db-backup container runs pg_dump once a day and keeps the dumps on the
# host, outside the Docker volume -- so they survive `docker compose down -v`,
# which deletes the database itself. See the backup section of README.md.
#
# Wall-clock time in TZ above. Pick an hour outside the market jobs' window.
BACKUP_AT=04:00
# Dumps older than this many days are deleted after a successful new one.
BACKUP_KEEP_DAYS=14
# Where they land, relative to deployment/. Point it at another disk if you
# have one -- a backup on the same disk as the database only covers mistakes,
# not hardware.
BACKUP_DIR=./backups

# --- API server ---
# Comma separated origins allowed by CORS (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8100

# Re-fetch the current month from the exchange if the cached copy is older than this
CURRENT_MONTH_TTL_SECONDS=900

# TWSE allows 3 requests per 5 seconds. Keep a safety margin.
THROTTLE_MAX_CALLS=3
THROTTLE_WINDOW_SECONDS=5.5

# --- Background jobs ---
# Master switch for the scheduler. Off means nothing fires on its own in this
# process; admins can still run jobs by hand from /admin/jobs. Set it to false
# on every replica but one, so a job is not run several times over.
JOBS_SCHEDULER_ENABLED=true
# Wall clock that a "每天 HH:MM" schedule is read in. Same value as TZ above.
SCHEDULER_TIMEZONE=Asia/Taipei

# --- Listed-instrument table ---
# The `stock_code` table is reconciled with the exchanges' ISIN registry on
# startup and on the schedule below -- this is what makes newly listed
# companies findable. Turning it off freezes the listing at whatever the table
# already holds; the rest of the API keeps working.
#
# These two only seed the *first* boot. Once an admin saves a schedule at
# /admin/jobs the `job_schedule` row wins, because a change made in the UI has
# to survive a container restart and nothing in the process can write back here.
STOCK_CODE_SYNC_ENABLED=true
STOCK_CODE_SYNC_INTERVAL_HOURS=24

# --- Auth / JWT ---
# Signing key for access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave it blank and the server generates a throwaway key per process: it still
# boots, but every restart logs a warning and signs everyone out.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# First ADMIN account, created on startup when both email and password are set.
# An existing account keeps its password; only its role is raised to ADMIN.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI analysis (Google Gemini) ---
# Blank switches the feature off cleanly: POST /api/stocks/{sid}/analysis/ai
# answers 503 and the frontend hides the button. Get a key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Low, not zero: the same bars should give the same call twice in a row, or a
# re-read looks like the market moved when only the sampler did.
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=45
# Thinking tokens come out of GEMINI_MAX_OUTPUT_TOKENS, so a model left to think
# freely can spend the budget before it writes any JSON -- which arrives as an
# empty response, not as a worse answer. Off by default: the reasoning here is
# reading ~30 pre-computed numbers against a rubric the prompt spells out. Raise
# it, and GEMINI_MAX_OUTPUT_TOKENS with it, to trade latency for depth.
GEMINI_THINKING_BUDGET=0

# Process-wide limiter on Gemini calls, the same shape as THROTTLE_* above. That
# one protects TWSE's rate limit; this one protects a bill.
AI_THROTTLE_MAX_CALLS=5
AI_THROTTLE_WINDOW_SECONDS=60

# Generations one account may pay for per day, reset on SCHEDULER_TIMEZONE's
# calendar. Verdicts are cached per (stock, trading day, model, prompt) and
# shared by everyone, so reading one somebody else generated is free and is not
# counted here.
AI_DAILY_QUOTA=20
AI_ADMIN_DAILY_QUOTA=200

# ---------------------------------------------------------------------------
# Single source of truth for both the PostgreSQL container (docker compose,
# which auto-loads this file) and the API server (server/app/config.py).
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=stockboard
POSTGRES_PASSWORD=stockboard
POSTGRES_DB=stockboard
POSTGRES_HOST=localhost
# Host-side port. 5433 avoids clashing with a PostgreSQL already on 5432.
POSTGRES_PORT=5433
TZ=Asia/Taipei

# Optional: set this to override the connection string built from the values
# above -- e.g. to point the server at a managed database instead.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Host-side ports published by docker compose for the two app containers.
SERVER_PORT=8000
FRONTEND_PORT=8100

# --- API server ---
# Comma separated origins allowed by CORS (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8100

# Re-fetch the current month from the exchange if the cached copy is older than this
CURRENT_MONTH_TTL_SECONDS=900

# TWSE allows 3 requests per 5 seconds. Keep a safety margin.
THROTTLE_MAX_CALLS=3
THROTTLE_WINDOW_SECONDS=5.5

# --- Listed-instrument table ---
# The `stock_code` table is reconciled with the exchanges' ISIN registry on
# startup and every interval after that -- this is what makes newly listed
# companies findable. Turning it off freezes the listing at whatever the table
# already holds; the rest of the API keeps working.
STOCK_CODE_SYNC_ENABLED=true
STOCK_CODE_SYNC_INTERVAL_HOURS=24

# --- Auth / JWT ---
# Signing key for access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave it blank and the server generates a throwaway key per process: it still
# boots, but every restart logs a warning and signs everyone out.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# First ADMIN account, created on startup when both email and password are set.
# An existing account keeps its password; only its role is raised to ADMIN.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Build context for server/Dockerfile is the repository root -- keep the local
# virtualenvs, caches and the Node tree out of it.
.git
.gitignore
**/.venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache

frontend/node_modules
frontend/dist
frontend/.pnpm-store
**/*.tsbuildinfo

# Documentation assets and the Playwright tool that produces them. Neither is
# built into any image, and tools/screenshots/node_modules carries a browser
# driver -- leaving them in the context makes every server build pay for it.
docs
tools

deployment/.env
**/*.log
